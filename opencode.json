{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/telos-context.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 131072
  },
  "agent": {
    "telos": {
      "description": "Runs TELOS CogOS reasoning pipeline on GridWorld tasks (and can apply code fixes when asked to ACT).",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "bash": "allow",
        "edit": "allow",
        "external_directory": "allow"
      }
    }
  }
}